GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Server-side OAuth sessions. The browser only holds a random session ID; the
# GitHub token is encrypted with AUTH_SESSION_SECRET and stored in Postgres.
# Use 32+ random characters. Falling back to GITHUB_CLIENT_SECRET works but is
# not recommended for production.
AUTH_SESSION_SECRET=replace_with_a_random_32_character_or_longer_secret
# Optional: keep sessions in a separate database/role from ORIN data.
# Defaults to ORIN_DATABASE_URL when unset.
# AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# The default repo scope supports this private portfolio repository.
# For a public-only repository, optionally reduce it to public_repo.
# GITHUB_OAUTH_SCOPE=repo

# Optional deployment overrides:
# APP_ORIGIN=https://yourdomain.com
# GITHUB_REPOSITORY_OWNER=sfeng01-tech
# GITHUB_REPOSITORY_NAME=Portfolio-Site
# GITHUB_REPOSITORY_BRANCH=main

# ORIN private digest storage (server only; never prefix with VITE_).
# Create a Neon Postgres database and apply apps/portfolio/server/orin-schema.sql once.
ORIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate 32+ random characters; use the same value in the GitHub Actions collector secret.
ORIN_INGEST_TOKEN=replace_with_a_random_32_character_or_longer_secret

# Local testing only: 1 reports a synthetic session on /api/auth/session and
# skips every GitHub OAuth/verification call. Inert unless NODE_ENV != production.
# ORIN_LOCAL_AUTH_BYPASS=1
# Tests and local dev only: process-local sessions instead of Postgres. Refuses
# to run when NODE_ENV=production.
# AUTH_SESSION_STORE=memory

# Collector only: see docs/ORIN-SOURCES.md for Actions secrets.
# On macOS, --keychain-openrouter can read the existing Keychain entry.
# Do not put a real key in this tracked file.
# OPENROUTER_API_KEY=
# Independent research worker and web API configuration (see docs/ORIN-RESEARCH.md).
# Defaults to DeepSeek V4.1 Flash 1017; override with another OpenRouter model if needed.
# ORIN_RESEARCH_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional web research; library-only research does not use Tavily.
# TAVILY_API_KEY=
# Conservative allowance per basic search; set at least your provider's actual cost.
# ORIN_RESEARCH_SEARCH_USD=0.02
# Ask ORIN (library-grounded answers). Apply
# apps/portfolio/server/orin-ask-schema.sql, then run
# `npm run ask:index --workspace=@portfolio/orin-collector` to build the passage
# index. Without the migration Ask still answers via a lexical library scan.
# Default Ask model. The UI can switch within the curated allowlist and choose
# a reasoning effort; arbitrary model IDs are rejected.
# ORIN_ASK_MODEL=deepseek/deepseek-v4.1-flash-1017

# Static portfolio deployment only: forward /orin to the Node backend.
# Leave unset on the Node service to avoid a redirect loop.
# VITE_ORIN_ORIGIN=https://orin-digest.onrender.com
