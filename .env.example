GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# The default repo scope supports this private portfolio repository.
# For a public-only repository, optionally reduce it to public_repo.
# GITHUB_OAUTH_SCOPE=repo

# Optional deployment overrides:
# APP_ORIGIN=https://yourdomain.com
# GITHUB_REPOSITORY_OWNER=sfeng01-tech
# GITHUB_REPOSITORY_NAME=Portfolio-Site
# GITHUB_REPOSITORY_BRANCH=main

# ORIN private digest storage (server only; never prefix with VITE_).
# Create a Neon Postgres database and apply apps/portfolio/server/orin-schema.sql once.
ORIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate 32+ random characters; use the same value in the GitHub Actions collector secret.
ORIN_INGEST_TOKEN=replace_with_a_random_32_character_or_longer_secret

# Collector only: see docs/ORIN-SOURCES.md for Actions secrets.
# On macOS, --keychain-openrouter can read the existing Keychain entry.
# Do not put a real key in this tracked file.
# OPENROUTER_API_KEY=

# Static portfolio deployment only: forward /orin to the Node backend.
# Leave unset on the Node service to avoid a redirect loop.
# VITE_ORIN_ORIGIN=https://orin-sahil.onrender.com
