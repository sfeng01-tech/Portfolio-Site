{
  "name": "portfolio-site-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/portfolio",
    "apps/orin-collector",
    "apps/orin-mcp"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@portfolio/site",
    "build": "npm run build --workspace=@portfolio/site && node scripts/copy-portfolio-build.mjs",
    "preview": "npm run preview --workspace=@portfolio/site",
    "start": "npm run start --workspace=@portfolio/site",
    "dev:server": "npm run dev:server --workspace=@portfolio/site",
    "test:portfolio": "npm run test --workspace=@portfolio/site",
    "test:orin": "npm run test --workspace=@portfolio/orin-collector",
    "test:orin-mcp": "npm run test --workspace=@portfolio/orin-mcp",
    "test": "npm run test:portfolio && npm run test:orin && npm run test:orin-mcp",
    "mcp:orin": "npm run start --workspace=@portfolio/orin-mcp",
    "mcp:orin:http": "npm run start:http --workspace=@portfolio/orin-mcp",
    "mcp:orin:remote": "npm run start:remote --workspace=@portfolio/orin-mcp",
    "collect": "npm run collect --workspace=@portfolio/orin-collector"
  }
}
