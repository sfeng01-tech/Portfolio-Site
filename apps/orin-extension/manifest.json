{
  "manifest_version": 3,
  "name": "ORIN Saver",
  "version": "0.1.0",
  "description": "Save the current page or any link into your ORIN digest without opening the ORIN web UI.",
  "permissions": ["contextMenus", "storage", "activeTab", "declarativeNetRequest", "declarativeNetRequestWithHostAccess", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "https://orin-digest.onrender.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to ORIN"
  },
  "options_page": "options.html",
  "commands": {
    "save-page": {
      "suggested_key": "Alt+Shift+O",
      "description": "Save current page to ORIN"
    }
  }
}
